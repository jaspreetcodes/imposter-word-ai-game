# Geoapify API Key for region autocomplete
# Get your free API key at: https://www.geoapify.com/get-started-with-maps-api
# Free tier: 3000 requests/day

# Word-gen API – browser hits this server (npm run word-gen-server), not Groq.
# Default: http://localhost:3001
VITE_WORDGEN_API_URL=http://localhost:3001

# Ollama (word-gen server uses phi3.5 by default via scripts/wordPipeline/ollamaWordGenerator.ts)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=phi3.5
# Word list quality pipeline (per category): set WORDGEN_USE_PIPELINE=0 for faster single-pass only
# WORDGEN_USE_PIPELINE=1
# WORDGEN_PIPELINE_MIN_COUNT=20

# Optional: minimum words per category before locale is considered "cached" (default 5)
# WORDGEN_MIN_WORDS_PER_CATEGORY=5
# Extended grounding: random seed words injected on cache miss (default 50)
# SEED_GROUNDING_COUNT=50

# --- QA / automated testing -------------------------------------------------
# Firebase emulators (npm run emulators). The e2e build reads these from .env.e2e.
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# VITE_FIRESTORE_EMULATOR_PORT=8080
# VITE_AUTH_EMULATOR_PORT=9099
# Compiles deterministic test hooks (seeded randomness, reveal timeout) into the bundle.
# VITE_E2E=true
# Seed/reset scripts target this emulator project.
# QA_FIREBASE_PROJECT_ID=demo-mafiasword
# Deterministic Ollama replacement for API contract tests (npm run qa:ollama-stub).
# OLLAMA_STUB_PORT=11434
# OLLAMA_STUB_FAIL=true      # force 500s to test error handling
# OLLAMA_STUB_DELAY_MS=0     # simulate a slow model host
# Readiness probe timeout for GET /ready on the word-gen server.
# WORDGEN_READINESS_TIMEOUT_MS=2000

# Seed dictionaries (gzip): npm run seed:download -- --all  |  migrate legacy .txt: npm run seed:migrate
# Offline pipeline from seed file: LANGUAGE=punjabi REGION=Punjab npm run word-pipeline:seed
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b