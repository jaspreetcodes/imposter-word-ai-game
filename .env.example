# Geoapify API Key for region autocomplete
# Get your free API key at: https://www.geoapify.com/get-started-with-maps-api
# Free tier: 3000 requests/day

# Word-gen API – only needed for "Generate words" in categories
# Default: http://localhost:3001 (run: npm run word-gen-server)
# VITE_WORDGEN_API_URL=http://localhost:3001

# Groq API for word-gen server. Get key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key
# Model: openai/gpt-oss-120b (default, 81+ languages) or llama-3.1-8b-instant (cheaper)
GROQ_MODEL=openai/gpt-oss-120b