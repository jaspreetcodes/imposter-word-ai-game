# Vite mode used by automated tests: npm run build:e2e (vite --mode e2e).
# Compiles in the deterministic test hooks and points Firebase at the emulators.
# Safe to commit: contains no real credentials.
VITE_E2E=true
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-mafiasword
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099
VITE_WORDGEN_API_URL=http://127.0.0.1:3001
