{
  "name": "imposter-word-ai-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "lint": "eslint .",
    "test": "node --import tsx --test src/**/*.test.ts scripts/**/*.test.ts",
    "preview": "vite preview",
    "preview:e2e": "vite preview --port 4173 --strictPort",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-mafiasword",
    "emulators:exec": "firebase emulators:exec --only auth,firestore --project demo-mafiasword",
    "qa:seed": "tsx scripts/qa/seedEmulators.ts",
    "qa:reset": "tsx scripts/qa/seedEmulators.ts --reset",
    "qa:ollama-stub": "tsx scripts/qa/ollamaStub.ts",
    "cypress:open": "cypress open",
    "e2e:smoke": "cypress run --spec \"cypress/e2e/smoke/**/*.cy.ts\"",
    "e2e:regression": "cypress run --spec \"cypress/e2e/smoke/**/*.cy.ts,cypress/e2e/regression/**/*.cy.ts\"",
    "e2e:known-defects": "cypress run --spec \"cypress/e2e/known-defects/**/*.cy.ts\"",
    "e2e:smoke:ci": "cypress run --spec \"cypress/e2e/smoke/**/*.cy.ts\" --reporter junit --reporter-options \"mochaFile=reports/cypress/smoke-[hash].xml\"",
    "e2e:regression:ci": "cypress run --spec \"cypress/e2e/smoke/**/*.cy.ts,cypress/e2e/regression/**/*.cy.ts\" --reporter junit --reporter-options \"mochaFile=reports/cypress/regression-[hash].xml\"",
    "e2e:known-defects:ci": "cypress run --spec \"cypress/e2e/known-defects/**/*.cy.ts\" --reporter junit --reporter-options \"mochaFile=reports/cypress/known-defects-[hash].xml\"",
    "e2e:ci": "start-server-and-test preview:e2e http://127.0.0.1:4173 e2e:smoke:ci",
    "e2e:ci:regression": "start-server-and-test preview:e2e http://127.0.0.1:4173 e2e:regression:ci",
    "api:test": "newman run postman/word-gen-api.postman_collection.json -e postman/ci.postman_environment.json --reporters cli,junit,json,htmlextra --reporter-junit-export reports/newman/newman-report.xml --reporter-json-export reports/newman/newman-report.json --reporter-htmlextra-export reports/newman/newman-report.html",
    "api:test:staging": "newman run postman/word-gen-api.postman_collection.json -e postman/staging.postman_environment.json --reporters cli,junit,json --reporter-junit-export reports/newman/staging-report.xml --reporter-json-export reports/newman/staging-report.json",
    "qa:summary": "node scripts/qa/summariseResults.mjs",
    "load:smoke": "mkdir -p reports/k6 && k6 run --summary-export reports/k6/summary.json k6/word-read-smoke.js",
    "load:generation": "mkdir -p reports/k6 && k6 run --summary-export reports/k6/summary.json k6/generation-reliability.js",
    "word-pipeline:load": "tsx scripts/wordPipeline/loadStaticLists.ts",
    "word-pipeline:sample-seed": "tsx scripts/wordPipeline/sampleSeedWords.ts",
    "word-pipeline:categorize": "tsx scripts/wordPipeline/categorizeWithMistral.ts",
    "word-pipeline:pos-filter": "tsx scripts/wordPipeline/filterPartOfSpeech.ts",
    "word-pipeline:filter": "tsx scripts/wordPipeline/filterByRecognizability.ts",
    "word-pipeline:export": "tsx scripts/wordPipeline/exportToFirestore.ts",
    "word-pipeline": "npm run word-pipeline:load && npm run word-pipeline:categorize && npm run word-pipeline:filter && npm run word-pipeline:export",
    "word-pipeline:seed": "npm run word-pipeline:sample-seed && npm run word-pipeline:categorize && npm run word-pipeline:pos-filter && npm run word-pipeline:filter && npm run word-pipeline:export",
    "seed:download": "tsx scripts/wordPipeline/downloadSeedLists.ts",
    "seed:migrate": "tsx scripts/wordPipeline/downloadSeedLists.ts --migrate",
    "word-qa": "tsx scripts/wordPipeline/runWordQa.ts",
    "word-generate": "tsx scripts/wordPipeline/wordGenerator.ts",
    "word-generate:ollama": "tsx scripts/wordPipeline/ollamaWordGenerator.ts",
    "word-gen-server": "tsx scripts/wordGenServer.ts",
    "word-qa:loanwords": "tsx scripts/wordPipeline/reportEnglishLoanwords.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase": "^12.6.0",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@langchain/core": "^0.3.0",
    "@langchain/ollama": "^0.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "cypress": "^15.19.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "express": "^4.21.0",
    "firebase-tools": "^15.25.1",
    "globals": "^16.4.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "start-server-and-test": "^3.0.12",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
